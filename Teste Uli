local espBoxEnabled = true
local espTracerEnabled = true
local ESPS = {}

local function newDrawing(kind)
    if not Drawing then return nil end
    local ok, obj = pcall(function() return Drawing.new(kind) end)
    if ok then return obj end
    return nil
end

-- ==========================================
-- 4. FUNÇÕES DO ESP (DESENHO)
-- ==========================================
local function CreateESP(plr)
    if ESPS[plr] then return end
    
    local tbl = {
        box = newDrawing("Square"),
        name = newDrawing("Text"),
        healthBar = newDrawing("Line"),
        healthBg = newDrawing("Line"),
        tracer = newDrawing("Line"),
        skeleton = {}
    }
    
    -- Configurações da Caixa
    if tbl.box then
        tbl.box.Thickness = 1
        tbl.box.Filled = false
        tbl.box.Color = COLOR_ACCENT
    end
    
    -- Configurações do Nome
    if tbl.name then
        tbl.name.Size = 14
        tbl.name.Center = true
        tbl.name.Outline = true
        tbl.name.Color = COLOR_TEXT
    end
    
    -- Configurações da Vida (Barra Verde)
    if tbl.healthBar then
        tbl.healthBar.Thickness = 2
        tbl.healthBar.Color = Color3.fromRGB(0, 255, 0)
    end
    if tbl.healthBg then
        tbl.healthBg.Thickness = 2
        tbl.healthBg.Color = Color3.fromRGB(0, 0, 0)
    end
    
    -- Configurações do Tracer (Linha)
    if tbl.tracer then
        tbl.tracer.Thickness = 1
        tbl.tracer.Color = Color3.fromRGB(255, 0, 0)
    end
    
    -- Criação dos ossos do esqueleto
    for i = 1, 6 do
        tbl.skeleton[i] = newDrawing("Line")
        if tbl.skeleton[i] then
            tbl.skeleton[i].Thickness = 1
            tbl.skeleton[i].Color = Color3.fromRGB(255, 165, 0) -- Laranja igual a foto
        end
    end
    
    ESPS[plr] = tbl
end

local function RemoveESP(plr)
    if not ESPS[plr] then return end
    for _, obj in pairs(ESPS[plr]) do
        if typeof(obj) == "table" then
            for _, line in pairs(obj) do if line and line.Remove then line:Remove() end end
        elseif obj and obj.Remove then
            obj:Remove()
        end
    end
    ESPS[plr] = nil
end

local function UpdateESP()
    local camPos = Camera.CFrame.Position
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= Player and plr.Character then
            local char = plr.Character
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChild("Humanoid")
            
            if head and hrp and humanoid and humanoid.Health > 0 and espEnabled then
                local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local hrpPos = Camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    if not ESPS[plr] then CreateESP(plr) end
                    local tbl = ESPS[plr]
                    
                    -- Distância
                    local dist = (camPos - hrp.Position).Magnitude
                    local boxHeight = math.clamp(2500 / dist, 40, 300)
                    local boxWidth = boxHeight / 2
                    
                    -- Atualizar Caixa
                    if tbl.box then
                        tbl.box.Visible = espBoxEnabled
                        tbl.box.Size = Vector2.new(boxWidth, boxHeight)
                        tbl.box.Position = Vector2.new(headPos.X - boxWidth/2, headPos.Y - boxHeight/4)
                    end
                    
                    -- Atualizar Nome e Distância
                    if tbl.name then
                        tbl.name.Visible = true
                        tbl.name.Text = plr.Name .. " [" .. math.floor(dist) .. "m]"
                        tbl.name.Position = Vector2.new(headPos.X, headPos.Y - boxHeight/4 - 15)
                    end
                    
                    -- Atualizar Barra de Vida
                    if tbl.healthBar and tbl.healthBg then
                        local hpPct = humanoid.Health / humanoid.MaxHealth
                        local barPos = Vector2.new(tbl.box.Position.X - 5, tbl.box.Position.Y)
                        local barSize = boxHeight
                        
                        tbl.healthBg.Visible = true
                        tbl.healthBg.From = barPos
                        tbl.healthBg.To = barPos + Vector2.new(0, barSize)
                        
                        tbl.healthBar.Visible = true
                        tbl.healthBar.From = barPos + Vector2.new(0, barSize * (1 - hpPct))
                        tbl.healthBar.To = barPos + Vector2.new(0, barSize)
                    end
                    
                    -- Atualizar Tracer (Linha do meio da tela até o jogador)
                    if tbl.tracer then
                        tbl.tracer.Visible = espTracerEnabled
                        tbl.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        tbl.tracer.To = Vector2.new(headPos.X, headPos.Y + boxHeight/4)
                    end
                    
                    -- Atualizar Esqueleto
                    if espSkeletonEnabled then
                        local parts = {
                            head = char:FindFirstChild("Head"),
                            upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"),
                            lowerTorso = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso"),
                            leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm"),
                            rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm"),
                            leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg"),
                            rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
                        }
                        
                        local function getPos(part)
                            if part then
                                local p, onS = Camera:WorldToViewportPoint(part.Position)
                                if onS then return Vector2.new(p.X, p.Y) end
                            end
                            return nil
                        end
                        
                        local hP = getPos(parts.head)
                        local utP = getPos(parts.upperTorso)
                        local ltP = getPos(parts.lowerTorso)
                        local laP = getPos(parts.leftArm)
                        local raP = getPos(parts.rightArm)
                        local llP = getPos(parts.leftLeg)
                        local rlP = getPos(parts.rightLeg)
                        
                        -- Desenha as linhas ligando os pontos
                        if hP and utP then tbl.skeleton[1].From = hP; tbl.skeleton[1].To = utP; tbl.skeleton[1].Visible = true else tbl.skeleton[1].Visible = false end
                        if utP and ltP then tbl.skeleton[2].From = utP; tbl.skeleton[2].To = ltP; tbl.skeleton[2].Visible = true else tbl.skeleton[2].Visible = false end
                        if utP and laP then tbl.skeleton[3].From = utP; tbl.skeleton[3].To = laP; tbl.skeleton[3].Visible = true else tbl.skeleton[3].Visible = false end
                        if utP and raP then tbl.skeleton[4].From = utP; tbl.skeleton[4].To = raP; tbl.skeleton[4].Visible = true else tbl.skeleton[4].Visible = false end
                        if ltP and llP then tbl.skeleton[5].From = ltP; tbl.skeleton[5].To = llP; tbl.skeleton[5].Visible = true else tbl.skeleton[5].Visible = false end
                        if ltP and rlP then tbl.skeleton[6].From = ltP; tbl.skeleton[6].To = rlP; tbl.skeleton[6].Visible = true else tbl.skeleton[6].Visible = false end
                    else
                        for i = 1, 6 do if tbl.skeleton[i] then tbl.skeleton[i].Visible = false end end
                    end
                else
                    if ESPS[plr] then
                        if ESPS[plr].box then ESPS[plr].box.Visible = false end
                        if ESPS[plr].name then ESPS[plr].name.Visible = false end
                        if ESPS[plr].healthBar then ESPS[plr].healthBar.Visible = false; ESPS[plr].healthBg.Visible = false end
                        if ESPS[plr].tracer then ESPS[plr].tracer.Visible = false end
                        for i = 1, 6 do if ESPS[plr].skeleton[i] then ESPS[plr].skeleton[i].Visible = false end end
                    end
                end
            else
                if ESPS[plr] then
                    if ESPS[plr].box then ESPS[plr].box.Visible = false end
                    if ESPS[plr].name then ESPS[plr].name.Visible = false end
                    if ESPS[plr].healthBar then ESPS[plr].healthBar.Visible = false; ESPS[plr].healthBg.Visible = false end
                    if ESPS[plr].tracer then ESPS[plr].tracer.Visible = false end
                    for i = 1, 6 do if ESPS[plr].skeleton[i] then ESPS[plr].skeleton[i].Visible = false end end
                end
            end
        end
    end
end

