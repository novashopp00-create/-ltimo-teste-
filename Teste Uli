-- Lógica do Dropdown de TP
local currentTPTarget = nil
local function UpdateTPList()
    local plrs = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player then table.insert(plrs, p.Name) end
    end
    table.insert(plrs, 1, "Selecionar Jogador")
    -- Aqui simulamos um menu clicável simples
    local nextTarget = plrs[math.random(1, #plrs)]
    currentTPTarget = nextTarget
    TPButton.Text = "Alvo: " .. currentTPTarget
end

TPButton.MouseButton1Click:Connect(function()
    UpdateTPList()
    if currentTPTarget and currentTPTarget ~= "Selecionar Jogador" then
        local target = Players:FindFirstChild(currentTPTarget)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            -- Teleporta o jogador local para a posição do alvo
            Player.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 2)
        end
    end
end)

